# Plantilla para .env — copiar a `.env` y rellenar.
# Solo se usa para la vía PROGRAMÁTICA del ETL (src/etl/).
# La vía primaria es el DataSource del IDE (`usecases@uaxmathfis.database.windows.net`),
# que no necesita .env.
#
# Auth: Azure AD interactiva. NO se almacena password — el driver
# abrirá el navegador para login al ejecutar la conexión.

# --- Azure SQL (proyecto UAX, base de datos `usecases`) ---
AZURE_SQL_SERVER=uaxmathfis.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=usecases
AZURE_SQL_USER=abarrrui@uax.es           # UPN del usuario AAD
AZURE_SQL_AUTHENTICATION=ActiveDirectoryInteractive
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server   # macOS: instalar vía `brew install msodbcsql18`

# --- Reproducibilidad ---
SEED=42